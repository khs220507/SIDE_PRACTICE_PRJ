{
  "name": "side-iot-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "e2e": "npm run e2e -w apps/web",
    "api:test": "cd apps/api && .venv\\Scripts\\python.exe -m pytest",
    "api:dev": "cd apps/api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "api:simulate": "cd apps/api && .venv\\Scripts\\python.exe -m app.simulator"
  }
}
